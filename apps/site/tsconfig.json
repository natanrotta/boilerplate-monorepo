{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"],
      // The product's design system, compiled from source (see vite.config.ts).
      // It imports Chakra from outside this folder and has no node_modules of
      // its own, so Chakra's types are pinned to this project's copy.
      "@boilerplate/theme": ["../../packages/theme/src/index.ts"],
      "@chakra-ui/react": ["./node_modules/@chakra-ui/react/dist/types/index.d.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
