{
  "name": "@boilerplate/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boilerplate - Web Client",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "typegen": "chakra typegen src/app/theme/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test:e2e": "tsx scripts/e2e-run.ts",
    "test:e2e:keep": "tsx scripts/e2e-run.ts --keep",
    "test:e2e:ui": "tsx scripts/e2e-run.ts --keep --ui",
    "test:e2e:headed": "tsx scripts/e2e-run.ts --keep --headed",
    "test:e2e:down": "docker compose -f ../../docker-compose.e2e.yml down -v",
    "test:e2e:report": "npx playwright show-report .playwright/report"
  },
  "dependencies": {
    "@boilerplate/shared-types": "*",
    "@boilerplate/theme": "*",
    "@bugsnag/browser-performance": "^3.4.1",
    "@bugsnag/js": "^8.10.0",
    "@chakra-ui/react": "^3.30.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "axios": "^1.18.1",
    "i18next": "^25.8.20",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.23.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^6.20.0",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
