# ============================================================================
# E2E ENVIRONMENT OVERRIDES (apps/api) — test-only values, safe to commit.
# Used with docker-compose.e2e.yml (Postgres 5433 / Redis 6380) by
# apps/web/scripts/e2e-run.ts, which reads apps/api/.env.e2e when it exists and
# falls back to this file otherwise (CI, fresh worktrees).
# ============================================================================
NODE_ENV=local
# The quick-login spec (e2e/tests/dev-quick-login.spec.ts) needs the dev routes.
DEV_QUICK_LOGIN_ENABLED=true
API_PORT=3334
ALLOWED_ORIGIN=http://localhost:3002
FRONTEND_URL=http://localhost:3002

DATABASE_URL="postgresql://postgres:e2e@localhost:5433/boilerplate_e2e?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# Test-only signing key (never used outside the ephemeral e2e stack).
JWT_SECRET=e2e-only-jwt-secret-not-a-real-secret-0000

# The suite never sends real e-mail — the console mail provider takes over.
RESEND_API_KEY=

# The auth specs hit the IP-keyed auth limiter more than its default allows.
RATE_LIMIT_AUTH_MAX=100
